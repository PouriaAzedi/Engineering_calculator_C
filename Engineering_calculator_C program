// Calculate factorial of a non-negative integer
// Returns 0.0 for negative input (invalid factorial)
double fact(int a) {
    if (a < 0) return 0.0;

    double res = 1.0;
    for (int i = 2; i <= a; i++) {
        res *= i;
    }
    return res;
}

// Generate a random integer in the range [0, a-1]
// Seeds the random number generator only once
int my_random(int a) {
    if (a <= 0) return 0;

    static int seeded = 0;
    if (!seeded) {
        srand((unsigned int)time(NULL));
        seeded = 1;
    }

    return rand() % a;
}

// ====================== TOKENIZER & PARSER ======================

// Token types produced by the tokenizer
typedef enum {
    TOK_NUMBER,   // numeric literal
    TOK_IDENT,    // identifier (function name, constant, or variable)
    TOK_OP,       // operator (+, -, *, /, ^, !, &)
    TOK_LPAREN,   // left parenthesis '('
    TOK_RPAREN,   // right parenthesis ')'
    TOK_END       // end of input
} TokenType;

// Structure representing a single token
typedef struct {
    TokenType type;     // type of token
    char text[128];     // original text (for identifiers/operators)
    double value;       // numeric value if TOK_NUMBER
} Token;

// Parser state: keeps track of source string and current token
typedef struct {
    const char* src;    // source expression string
    size_t pos;         // current position in source
    Token current;      // current lookahead token
} Parser;

// Advance to the next token in the parser input
static void next_token(Parser* p) {
    // Skip all whitespace characters
    while (isspace((unsigned char)p->src[p->pos])) {
        p->pos++;
    }

    // End of string: create an END token
    if (p->src[p->pos] == '\0') {
        p->current.type = TOK_END;
        p->current.text[0] = '\0';
        p->current.value = 0.0;
        return;
    }

    char c = p->src[p->pos];

    // Number (also supports scientific notation like 1e5)
    if (isdigit((unsigned char)c) || c == '.') {
        char* end = NULL;
        double val = strtod(&p->src[p->pos], &end);

        // If no number could be parsed, return END
        if (end == &p->src[p->pos]) {
            p->current.type = TOK_END;
            p->current.text[0] = '\0';
            return;
        }

        p->current.type = TOK_NUMBER;
        p->current.value = val;

        // Copy the numeric text into the token text field
        size_t len = (size_t)(end - &p->src[p->pos]);
        if (len >= sizeof(p->current.text)) {
            len = sizeof(p->current.text) - 1;
        }
        memcpy(p->current.text, &p->src[p->pos], len);
        p->current.text[len] = '\0';

        // Update parser position
        p->pos = (size_t)(end - p->src);
        return;
    }

    // Identifier / function name / constant
    if (isalpha((unsigned char)c)) {
        size_t start = p->pos;
        while (isalnum((unsigned char)p->src[p->pos]) || p->src[p->pos] == '_') {
            p->pos++;
        }

        size_t len = p->pos - start;
        if (len >= sizeof(p->current.text)) {
            len = sizeof(p->current.text) - 1;
        }
        memcpy(p->current.text, &p->src[start], len);
        p->current.text[len] = '\0';

        p->current.type = TOK_IDENT;
        p->current.value = 0.0;
        return;
    }

    // Operators and parentheses
    if (c == '(' || c == ')' || strchr("+-*/^!&", c)) {
        if (c == '(') {
            p->current.type = TOK_LPAREN;
        }
        else if (c == ')') {
            p->current.type = TOK_RPAREN;
        }
        else {
            p->current.type = TOK_OP;
        }

        p->current.text[0] = c;
        p->current.text[1] = '\0';
        p->current.value = 0.0;
        p->pos++;
        return;
    }

    // Unknown character: end parsing
    p->current.type = TOK_END;
    p->current.text[0] = '\0';
}

// Recursive descent parser function prototypes
static double parse_expression(Parser* p);
static double parse_term(Parser* p);
static double parse_unary(Parser* p);
static double parse_exponent(Parser* p);
static double parse_primary(Parser* p);

// Apply a named mathematical function to a numeric argument
// Returns 0.0 if the function name is not recognized
static double apply_function(const char* name, double n) {
    // Trigonometric functions (respect degree/radian mode)
    if (strcmp(name, "sin") == 0) {
        return degreeMode.mode ? sin(n * PI / 180.0) : sin(n);
    }
    if (strcmp(name, "cos") == 0) {
        return degreeMode.mode ? cos(n * PI / 180.0) : cos(n);
    }
    if (strcmp(name, "tan") == 0) {
        return degreeMode.mode ? tan(n * PI / 180.0) : tan(n);
    }
    if (strcmp(name, "cot") == 0) {
        double t = degreeMode.mode ? tan(n * PI / 180.0) : tan(n);
        if (fabs(t) < 1e-12) return 0.0; // avoid division by zero
        return 1.0 / t;
    }

    // Logarithmic and exponential functions
    if (strcmp(name, "ln") == 0) {
        return log(n);
    }
    if (strcmp(name, "log") == 0) {
        return log10(n);
    }
    if (strcmp(name, "exp") == 0) {
        return exp(n);
    }

    // Other common functions
    if (strcmp(name, "sqrt") == 0) {
        return sqrt(n);
    }
    if (strcmp(name, "abs") == 0) {
        return fabs(n);
    }

    // Inverse trigonometric functions (respect degree/radian mode)
    if (strcmp(name, "asin") == 0) {
        double rad = asin(n);
        return degreeMode.mode ? rad * 180.0 / PI : rad;
    }
    if (strcmp(name, "acos") == 0) {
        double rad = acos(n);
        return degreeMode.mode ? rad * 180.0 / PI : rad;
    }
    if (strcmp(name, "atan") == 0) {
        double rad = atan(n);
        return degreeMode.mode ? rad * 180.0 / PI : rad;
    }
    if (strcmp(name, "acot") == 0) {
        double rad = atan(1.0 / n);
        return degreeMode.mode ? rad * 180.0 / PI : rad;
    }

    // Random number generation: rand(n) returns integer in [0, n-1]
    if (strcmp(name, "rand") == 0) {
        return (double)my_random((int)n);
    }

    return 0.0; // unknown function
}

// Parse a primary expression: number, identifier, function call, or parenthesized expression
static double parse_primary(Parser* p) {
    // Number literal
    if (p->current.type == TOK_NUMBER) {
        double val = p->current.value;
        next_token(p);

        // Postfix factorial: 5!
        if (p->current.type == TOK_OP && p->current.text[0] == '!') {
            next_token(p);
            return fact((int)val);
        }

        return val;
    }

    // Previous result: &
    if (p->current.type == TOK_OP && p->current.text[0] == '&') {
        next_token(p);
        return degreeMode.result;
    }

    // Identifier: constant or function
    if (p->current.type == TOK_IDENT) {
        char name[128];
        strcpy(name, p->current.text);

        // Constant pi
        if (strcmp(name, "p") == 0 || strcmp(name, "PI") == 0) {
            next_token(p);
            return PI;
        }

        // Constant e
        if (strcmp(name, "e") == 0 || strcmp(name, "E") == 0) {
            next_token(p);
            return E;
        }

        // Function call: consume identifier
        next_token(p);

        if (p->current.type == TOK_LPAREN) {
            next_token(p); // consume '('

            double arg = parse_expression(p);

            // Consume ')' if present
            if (p->current.type == TOK_RPAREN) {
                next_token(p); // consume ')'
            }

            double val = apply_function(name, arg);

            // Postfix factorial after function: sin(1)!
            if (p->current.type == TOK_OP && p->current.text[0] == '!') {
                next_token(p);
                return fact((int)val);
            }

            return val;
        }

        // Unknown identifier or variable x
        // In graph mode, x should be replaced before parsing
        if (strcmp(name, "x") == 0) {
            return 0.0;
        }

        return 0.0; // unknown identifier
    }

    // Parenthesized expression
    if (p->current.type == TOK_LPAREN) {
        next_token(p); // consume '('

        double val = parse_expression(p);

        if (p->current.type == TOK_RPAREN) {
            next_token(p); // consume ')'
        }

        // Postfix factorial after parentheses: (2+3)!
        if (p->current.type == TOK_OP && p->current.text[0] == '!') {
            next_token(p);
            return fact((int)val);
        }

        return val;
    }

    return 0.0; // fallback
}

// Parse exponentiation (^), which is right-associative
static double parse_exponent(Parser* p) {
    double base = parse_primary(p);

    // Right-associative exponentiation
    if (p->current.type == TOK_OP && p->current.text[0] == '^') {
        next_token(p);
        double exponent = parse_exponent(p);
        return pow(base, exponent);
    }

    return base;
}

// Parse unary operators: +x, -x, !x (prefix factorial)
static double parse_unary(Parser* p) {
    if (p->current.type == TOK_OP) {
        char op = p->current.text[0];

        if (op == '+' || op == '-' || op == '!') {
            next_token(p);
            double operand = parse_unary(p);

            if (op == '+') return operand;
            if (op == '-') return -operand;
            if (op == '!') return fact((int)operand);
        }
    }

    // If no unary operator, parse exponentiation
    return parse_exponent(p);
}

// Parse multiplication and division (left-associative)
static double parse_term(Parser* p) {
    double left = parse_unary(p);

    while (p->current.type == TOK_OP &&
           (p->current.text[0] == '*' || p->current.text[0] == '/')) {
        char op = p->current.text[0];
        next_token(p);

        double right = parse_unary(p);

        if (op == '*') {
            left *= right;
        }
        else {
            // Division by zero protection: set result to 0.0
            if (right == 0.0) {
                left = 0.0;
            }
            else {
                left /= right;
            }
        }
    }

    return left;
}

// Parse addition and subtraction (left-associative)
static double parse_expression(Parser* p) {
    double left = parse_term(p);

    while (p->current.type == TOK_OP &&
           (p->current.text[0] == '+' || p->current.text[0] == '-')) {
        char op = p->current.text[0];
        next_token(p);

        double right = parse_term(p);

        if (op == '+') {
            left += right;
        }
        else {
            left -= right;
        }
    }

    return left;
}

// ====================== SPLIT / EVALUATOR ======================

// Evaluate a mathematical expression string and return the result
double split(char* input) {
    if (!input || *input == '\0') {
        return 0.0;
    }

    Parser p;
    p.src = input;
    p.pos = 0;
    next_token(&p); // load first token

    return parse_expression(&p);
}

