// ====================== MAIN MENU ======================

// Main menu loop: displays menu, handles user choices, and asks to continue
void get_choose(void) {
    char ch;

    while (1) {
        showMenu();
        printf("Choice: ");

        if (scanf(" %c", &ch) != 1) {
            clear_input_buffer();
            continue;
        }

        clear_input_buffer();

        if (ch == '0') {
            show_help();
        }
        else if (ch == '1') {
            calculation();
        }
        else if (ch == '2') {
            showHistory();
        }
        else if (ch == '3') {
            clearHistory();
        }
        else if (ch == '4') {
            graph();
        }
        else if (ch == '5') {
            showGraphHistory();
        }
        else if (ch == 'e' || ch == 'E') {
            break; // exit program
        }
        else {
            printf("Invalid choice!\n");
        }

        printf("Continue? (y/n): ");

        if (scanf(" %c", &ch) != 1) {
            clear_input_buffer();
            break;
        }

        clear_input_buffer();

        if (ch == 'n' || ch == 'N') {
            break; // exit program
        }
    }
}
