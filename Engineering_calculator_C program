// ====================== DEGREE MODE ======================

// Prompt the user to select angle mode: radian or degree
void degree(void) {
    int a = 0;
    degreeMode.fail = false;

    printf("Angle mode: 0 = Radian (default), 1 = Degree\n");

    // Read user choice
    if (scanf("%d", &a) != 1) {
        clear_input_buffer();
        printf("Invalid input. Default to Radian.\n");
        degreeMode.fail = true;
        degreeMode.mode = false;
        return;
    }

    clear_input_buffer();

    if (a == 0) {
        degreeMode.mode = false; // radian mode
    }
    else if (a == 1) {
        degreeMode.mode = true;  // degree mode
    }
    else {
        printf("Invalid input. Default to Radian.\n");
        degreeMode.fail = true;
        degreeMode.mode = false;
    }
}

// ====================== CALCULATION ======================

// Perform a single calculation based on user input
void calculation(void) {
    char input[MAX_LINE];

    // Select angle mode first
    degree();
    if (degreeMode.fail) return;

    printf("Enter expression (e.g. 3+sin(45)^2): \n");

    // Read expression from user
    if (!fgets(input, MAX_LINE, stdin)) {
        return;
    }

    // Remove trailing newline character
    input[strcspn(input, "\n")] = '\0';

    // Save expression to history
    save_history(input);

    // Evaluate the expression
    double result = split(input);

    printf("Result = %.10f\n", result);

    // Save result to history and store it for '&' operator
    save_history1(result);
    save_history2(result);
}

// ====================== GRAPH ======================

// Plot an ASCII graph of a function entered by the user
void graph(void) {
    char input[MAX_LINE];

    printf("Enter function (e.g. sin(x) or x^2 + 3): \n");

    if (!fgets(input, MAX_LINE, stdin)) {
        return;
    }

    input[strcspn(input, "\n")] = '\0';

    double x_min = 0.0, x_max = 0.0;

    // Read x-axis minimum
    printf("x min: ");
    if (scanf("%lf", &x_min) != 1) {
        clear_input_buffer();
        printf("Invalid input.\n");
        return;
    }

    // Read x-axis maximum
    printf("x max: ");
    if (scanf("%lf", &x_max) != 1) {
        clear_input_buffer();
        printf("Invalid input.\n");
        return;
    }

    clear_input_buffer();

    // Validate range
    if (x_min >= x_max) {
        printf("Invalid range.\n");
        return;
    }

    // Select angle mode for trigonometric functions in graph
    degree();
    if (degreeMode.fail) return;

    // Save graph history to GraphHistory.txt
    FILE* gf = fopen("GraphHistory.txt", "a");
    if (gf) {
        fprintf(gf, "Function: %s | x in [%.10f, %.10f]\n", input, x_min, x_max);
        fclose(gf);
    }

    double arr[41]; // array to store y-values at 41 sample points

    // Evaluate function at 41 equally spaced x values
    for (int j = 0; j < 41; j++) {
        double x = x_min + j * (x_max - x_min) / 40.0;
        char* new_str = replace_x_with_number(input, x);

        if (new_str) {
            arr[j] = split(new_str);
            free(new_str);
        }
        else {
            arr[j] = 0.0;
        }
    }

    draw_graph(arr, x_min, x_max);
}

// Replace every occurrence of 'x' in a string with a numeric value in parentheses
// Returns a newly allocated string that must be freed by the caller
char* replace_x_with_number(const char* S, double N) {
    if (!S) return NULL;

    size_t input_len = strlen(S);

    // Allocate enough space for the worst-case expansion
    char* result = (char*)malloc(input_len * 60 + 2);
    if (!result) return NULL;

    char num[60];
    snprintf(num, sizeof(num), "(%.10f)", N);   // عدد داخل پرانتز (number inside parentheses)

    size_t i = 0, j = 0;

    while (S[i]) {
        if (S[i] == 'x') {
            // Check that 'x' is not part of a longer identifier
            int left_ok = (i == 0 ||
                           (!isalnum((unsigned char)S[i - 1]) && S[i - 1] != '_'));
            int right_ok = (S[i + 1] == '\0' ||
                            (!isalnum((unsigned char)S[i + 1]) && S[i + 1] != '_'));

            if (left_ok && right_ok) {
                strcpy(&result[j], num);
                j += strlen(num);
                i++;
                continue;
            }
        }

        result[j++] = S[i++];
    }

    result[j] = '\0';
    return result;
}

// Draw an ASCII graph from an array of y-values using a simple dot plot
void draw_graph(double arr[41], double x_min, double x_max) {
    double min = arr[0];
    double max = arr[0];

    // Find minimum and maximum y-values
    for (int i = 1; i < 41; i++) {
        if (arr[i] < min) min = arr[i];
        if (arr[i] > max) max = arr[i];
    }

    // Avoid division by zero for constant functions
    if (max - min == 0.0) {
        max = min + 1.0;
    }

    int height = 20;
    double value_per_row = (max - min) / height;

    // Draw rows from top to bottom
    for (int row = height; row >= 0; row--) {
        double y = min + row * value_per_row;
        printf("%8.2f |", y);

        // Print '*' at positions where the scaled value matches this row
        for (int col = 0; col < 41; col++) {
            int scaled_row = (int)floor((arr[col] - min) / value_per_row + 0.5);

            if (scaled_row == row) {
                printf("*");
            } else {
                printf(" ");
            }
        }

        printf("\n");
    }

    // Draw x-axis line
    printf("         +");
    for (int i = 0; i < 41; i++) {
        printf("-");
    }
    printf("\n");

    // Print x-axis labels at intervals
    printf("          ");
    for (int i = 0; i < 41; i += 5) {
        double x = x_min + i * (x_max - x_min) / 40.0;
        printf("%-5.1f", x);
    }
    printf("\n");
}

